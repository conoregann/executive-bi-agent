# Local PostgreSQL configuration for docker-compose.yml.
POSTGRES_DB=executive_bi
POSTGRES_USER=executive_bi
POSTGRES_PASSWORD=executive_bi_local_only
POSTGRES_PORT=5433
# API persistence (the fixtures remain synthetic; do not use this credential outside local development).
DATABASE_URL=postgres://executive_bi:executive_bi_local_only@127.0.0.1:5433/executive_bi

# Dedicated read-only connection for the synthetic analytics views.
ANALYTICS_DATABASE_URL=postgres://executive_bi_analytics:synthetic_analytics_local_only@127.0.0.1:5433/executive_bi

# Optional model-guided contextual investigation. Set both to enable; keep keys private.
OPENAI_API_KEY=
OPENAI_INVESTIGATION_MODEL=
